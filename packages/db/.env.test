# Test environment for `@repo/db`'s integration run (ADR-0004 §File layout, as
# carried by ADR-0082 §3).
#
# Committed on purpose, in the shape of `apps/api/.env.test`: it holds no real
# secret, and a clone with no root `.env` — a cloud session, CI — must get the
# same values a developer gets. `vitest.int.config.ts` loads it into every
# worker, over whatever the shell exported, so this tier reads no untracked
# file for the database it rebuilds.
#
# `TEST_DB_LANE` is deliberately absent. It comes from the shell — `pnpm
# db:lane` prints it for the current branch — and, when set, points both URLs
# below at `machxi_<lane>_test` (`src/tooling/test-database.ts`).

NODE_ENV=test

# The suite migrates and rebuilds this database on every run, and refuses any
# URL whose database name does not end in `_test` (ADR-0008).
#
# Two roles, not one (ADR-0061 §1): the harness rebuilds as the owner and the
# cases about the application role connect as `machxi_app`, so a missing grant
# fails here rather than in a deployment.
DATABASE_URL_TEST=postgres://machxi_app:machxi_app@localhost:5432/machxi_test
DATABASE_URL_TEST_OWNER=postgres://machxi_owner:machxi_owner@localhost:5432/machxi_test
# The cluster's superuser, read by `pnpm db:lane` alone (`scripts/db-lane.mjs`):
# creating a lane's database and handing its schema to the owner is what only
# a superuser may do. Nothing in this package's suite connects as it.
DATABASE_URL_TEST_SUPERUSER=postgres://machxi:machxi@localhost:5432/machxi_test
