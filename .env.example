# Root environment file — copy to `.env` and edit (ADR-0004).
#
#   cp .env.example .env
#
# One file feeds three consumers, which is why it lives at the root and not in
# apps/api:
#   * docker compose  → POSTGRES_* (docker/local/compose.yaml, ADR-0007)
#   * the API         → everything in the `core/config` zod schema (ADR-0004)
#   * db tooling      → DATABASE_URL (drizzle.config.ts, migrate, seeds, ADR-0008)
#
# `.env` is git-ignored; this file is committed and must list every variable
# with a safe default. Adding a variable is a three-place change: zod schema,
# this file, deployment secret store.

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Required — there is no default. Every production guard branches on it, so an
# absent NODE_ENV would silently mean "development": the committed signing key
# accepted, `*` allowed as a CORS origin, stack traces in error responses.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# The brand every derived name reads (ADR-0064 §1): the refresh cookie
# (__Secure-<APP_ID>.refresh), both CSRF cookies (__Host-<APP_ID>.csrf.admin
# and .user), the retired host-wide one, and the JWT audience
# (<APP_ID>-staff / <APP_ID>-user). Lowercase letters, digits and hyphens.
#
# A FORK-DAY VALUE, not a live knob (ADR-0064 §2): changing it after launch
# invalidates every refresh and CSRF cookie in every browser and orphans every
# device preference. There is no dual-read and no migration window. Set it once,
# before the first deployment, together with VITE_APP_ID in each app's .env and
# `node scripts/rename.mjs <name>` for the mechanical half.
APP_ID=machxi
# The release label and the commit (ADR-0081). Not set locally: they are
# stamped into an image at build, as build arguments, and nothing reads a
# package.json for them. Unset, /health answers version "dev" and no commit.
# Set them here only to see a label on a local run.
# APP_VERSION=
# GIT_SHA=
# Express `trust proxy` value: false | a hop count | a CIDR list | loopback.
# Keep it false locally; behind a load balancer set the number of proxies.
#
# NODE_ENV=production refuses BOTH constants, so a deployment has to state its
# hop (ADR-0059 §7, the delta on ADR-0004 and ADR-0020):
#   * `true`  — Express takes the left-most X-Forwarded-For entry verbatim, so
#     req.ip becomes attacker-controlled;
#   * `false` — behind a reverse proxy every request reports the proxy's
#     address instead, so all of them share one key.
# Either way req.ip stops meaning what the login rate limit, the refresh limit
# and the session audit trail assume it means, and neither failure shows up in
# a response — which is why both are startup failures.
TRUST_PROXY=false

# The three socket deadlines the process states rather than inherits from Node
# (ADR-0073 §4). Same duration form as the TTLs below.
#
#   * HTTP_REQUEST_TIMEOUT  — the whole request. Node's own default is 300s,
#     which is a slow-loris budget on an API whose slowest handler is one hash.
#   * HTTP_HEADERS_TIMEOUT  — the headers alone. The same hole one layer up.
#   * HTTP_KEEP_ALIVE_TIMEOUT — how long an idle connection is kept. Node's
#     default is 5s and a typical reverse proxy holds 60s, so the API closes a
#     connection the proxy is about to reuse: intermittent 502s in front of a
#     perfectly healthy process. **Set this above your proxy's**, so the proxy
#     is always the end that closes.
HTTP_REQUEST_TIMEOUT=30s
HTTP_HEADERS_TIMEOUT=10s
HTTP_KEEP_ALIVE_TIMEOUT=65s

# ─── Postgres (docker compose only) ───────────────────────────────────────────
# These create the container's superuser and default database on first start.
# Changing them after the volume exists has no effect — `pnpm docker:reset`.
#
# Nothing in this repository connects as this role any more (ADR-0061): it is
# the role that created the cluster and the one you reach for when something is
# wrong. The four URLs below name the two roles that do.
POSTGRES_USER=machxi
POSTGRES_PASSWORD=machxi
POSTGRES_DB=machxi
# Host port. Change this (not the container port) if 5432 is already taken,
# and update the host/port in the four DATABASE_URL* values to match.
POSTGRES_PORT=5432

# ─── Mailpit (docker compose only, ADR-0066 §1) ───────────────────────────────
# The local mail server. Host ports only — change them if 1025 or 8025 is
# taken, and point SMTP_PORT below at the first. The inbox is a web page at
# http://localhost:8025 and holds nothing across `pnpm docker:reset`.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Database (API + tooling) ─────────────────────────────────────────────────
# Two roles, created by docker/local/postgres/init/00-roles.sql on first start
# (ADR-0061 §1). A data volume that predates that file has neither: run
# `pnpm docker:reset`, or create the roles by hand, before `pnpm db:setup`.
#
#   machxi_app    what the API connects as. SELECT/INSERT/UPDATE/DELETE and
#                 nothing else — no DDL, no ownership, and no UPDATE or DELETE
#                 on audit_events, which the database refuses twice over.
#   machxi_owner  what packages/db's tooling connects as: db:migrate, db:seed,
#                 db:reset, drizzle-kit, and the integration harness.
#
# The owner variables have no fallback to DATABASE_URL by decision: a fallback
# is how a deployment ends up migrating as its application role and never
# finding out.
DATABASE_URL=postgres://machxi_app:machxi_app@localhost:5432/machxi
DATABASE_URL_OWNER=postgres://machxi_owner:machxi_owner@localhost:5432/machxi
# Tooling-only, not part of the API config schema: the integration test run
# migrates, truncates and re-seeds this database (ADR-0021). Created by
# docker/local/postgres/init/01-test-db.sql. The suite runs as the application
# role and the harness migrates and truncates as the owner, so the tests
# execute with exactly the privileges production has.
DATABASE_URL_TEST=postgres://machxi_app:machxi_app@localhost:5432/machxi_test
DATABASE_URL_TEST_OWNER=postgres://machxi_owner:machxi_owner@localhost:5432/machxi_test
DB_POOL_MAX=10
DB_CONNECT_RETRIES=10
# Session bounds, applied to every connection in the pool (ADR-0061 §3).
# Milliseconds; 0 disables. The statement timeout is set high enough that
# tripping it means something is wrong rather than that something is slow; the
# idle-in-transaction one exists because a transaction left open by a crashed
# handler holds its locks and stops autovacuum reclaiming rows database-wide.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000
# What pg_stat_activity shows for the API's sessions. Free, and the difference
# between "some connection is blocking" and "the API is blocking".
DB_APPLICATION_NAME=machxi-api
# Set to false behind a transaction-mode pooler (PgBouncer, Supabase's 6543
# port), where a prepared statement does not survive to the next query on the
# same logical connection.
DB_PREPARED_STATEMENTS=true

# ─── Auth (ADR-0018) ──────────────────────────────────────────────────────────
JWT_ISSUER=machxi-api
# Min 32 characters. The value below is a placeholder for local development —
# generate a real one per environment and never commit it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# This value is listed in KNOWN_PUBLIC_SECRETS and is refused outright when
# NODE_ENV=production, along with the one in apps/api/.env.test.
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me
# The key ring (ADR-0078 §2). Optional. Every access token names the secret it
# was signed under; a token naming this one still verifies, and nothing is
# signed with it. To rotate: move the current JWT_ACCESS_SECRET here, set a new
# one, restart, and remove this line after one JWT_ACCESS_TTL. It must differ
# from the current secret, and a committed value is refused in production.
# JWT_ACCESS_SECRET_PREVIOUS=
# Durations: a positive integer followed by s, m, h or d (at most 365d). Parsed
# to seconds at startup, so a typo fails there rather than at the first login.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
# Window in which the previous refresh token still works, so a lost response or
# a double-tap does not log the user out. Outside it, a replayed token is
# treated as stolen and the session is revoked (ADR-0018 §Refresh).
REFRESH_ROTATION_GRACE_SEC=30
# How many argon2 hashes may run at once. Each holds one libuv thread and
# 64 MiB for ~130 ms, so an uncapped login endpoint starves DNS and filesystem
# work process-wide (ADR-0020 §Hashing cost vs. liveness). Requests beyond the
# cap queue; beyond eight queued per slot they are shed with 503 + Retry-After.
# Raise this together with UV_THREADPOOL_SIZE below, never on its own.
AUTH_MAX_CONCURRENT_HASHES=4
# How many live sessions one account may hold (ADR-0073 §3). The eleventh login
# revokes the oldest with `revoked_reason = 'session_cap'` rather than refusing
# the new one — a person whose device was stolen is signing in from the
# replacement. An impersonated session counts against the customer and is never
# the one revoked; it ends on its own clock. `0` means uncapped, which is what
# a deployment that would rather run `db:sessions:prune` alone can state.
AUTH_MAX_SESSIONS_PER_PRINCIPAL=10

# ─── Password hashing (ADR-0018, @repo/crypto defaultArgon2Params) ────────────
# argon2id. Values below the OWASP floor (19456 / 2 / 1) are rejected at
# startup and by the seeders, so lowering these to speed up tests will fail.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Not read by the API — a Node runtime knob. Each hash occupies one libuv
# thread for ~130 ms, and the default pool is 4, so deployments expecting
# concurrent logins raise this (ADR-0020 §Hashing cost vs. liveness).
# UV_THREADPOOL_SIZE=8

# ─── HTTP security (ADR-0020, ADR-0069) ───────────────────────────────────────
# Per 15 minutes. The global one is keyed on IP and covers /api; the login one
# is keyed on IP + email and also covers registration; the refresh one is keyed
# on IP and counts **failed** refreshes only, so a client refreshing normally
# never spends its budget. /health is outside all three (ADR-0016, ADR-0020).
#
# 1000 rather than the schema default of 300, because this is the
# **development** profile and this repository is now a legitimate consumer of a
# whole window: `pnpm test:e2e` runs both browser suites back to back through
# one in-memory limiter, and `pnpm test:postman` is a collection beside them.
# The number holds a failed run of all of it **and its retry**, and still
# refuses a client stuck in a render loop within a minute (ADR-0069). A
# deployment inherits nothing from here — the schema default stays 300 and
# docker/prod/.env.example carries no value at all; size it to your own traffic
# after reading ADR-0020 §Residual risks.
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_MAX=5
# The impersonation mint (POST /admin/users/:id/impersonate) is keyed on the
# **staff member's id**, not on an IP: it is authenticated and high-value, and
# the login limiter's IP+email key reads a body a mint does not carry
# (ADR-0057 §1). Ten per window is a support desk's day.
RATE_LIMIT_IMPERSONATION_MAX=10
# Per **hour**, keyed on address and email — the one limiter with a window of
# its own (ADR-0020 reserved the row, ADR-0071 §4 spends it). Three rather than
# the login limiter's ten, because what is being rationed is different: a login
# attempt costs the attacker a guess, a `forgot` costs the *victim* a message in
# their inbox. Nobody legitimately asks for a fourth reset link inside an hour.
RATE_LIMIT_PASSWORD_RESET_MAX=3
# The window that 3 is *per*, and a variable rather than a constant because
# every other limiter above takes the module's fixed 15 minutes: a 3 with no
# hour to be per is a 3 per quarter hour, which is four times the budget the
# record decided and nothing would fail to say so.
RATE_LIMIT_PASSWORD_RESET_WINDOW=1h
# The same hour, keyed on the **mailbox alone** — no IP in the key (ADR-0071 §4,
# amended at `D18.5`). The 3 above bounds one sender mailing one mailbox; this
# bounds the mailbox, which nothing else does: the global limiter is keyed on
# the source address too, so `3 × N` messages from N sources had no ceiling.
# Larger than the 3 on purpose — a person asking from a phone and then a laptop
# is two sources and one mailbox.
RATE_LIMIT_MAILBOX_MAX=5
# The same hour again, keyed on the **source address alone** — no email in the
# key (ADR-0071 §4, amended at `D18.7`). The two above both carry the address
# the request names, so both reset when it changes and neither can see one
# source walking a list of strangers' mailboxes; this is that ceiling, shared
# by `forgot`, `resend-verification` and `register`.
#
# 200 rather than the schema default of 20, and for ADR-0069's reason: this is
# the **development** profile, where `pnpm test:postman` and `pnpm test:e2e`
# are legitimate senders — a full verification pass mails about ten times from
# one source, and a developer iterating on those suites does it repeatedly
# inside one hour. A deployment inherits nothing from here. Unlike the two
# above, its number is a **capacity** number: the key is a source address,
# which behind a carrier-grade NAT is thousands of people, so size it to your
# own traffic (docs/deploy.md names it as the first of the three to raise).
RATE_LIMIT_MAIL_SOURCE_MAX=200
# Per 15 minutes, keyed on the **caller's account** — the fifth category, on
# every authenticated route that verifies a password (ADR-0073 §1): the four on
# `/user/profile` (change-password, the delete, the unlink and change-email)
# and the four `POST /admin/{staff,users}/:id/{password,email}`. It bounds two
# things at once — a handful of authenticated clients making the hash pool shed
# *login* for everybody, and an operator's `403` on the administrative resets
# being an unbounded oracle against their own password.
#
# 100 rather than the schema default of 10, and for ADR-0069's reason applied
# to a second limiter: this is the **development** profile, and this repository
# is a legitimate consumer of a whole budget. `pnpm test:postman` drives eleven
# of these routes as the seeded super admin in one run — two password resets,
# three address changes on each of `staff` and `users`, and the invited
# operator's — so a deployment's ten would refuse a stock clone its own
# verification, in the middle of a folder that is not about rate limiting. The
# number holds a failed run and its retry inside one window. A deployment
# inherits nothing from here: the schema default stays 10, which is the
# anti-abuse number — nobody changes their password ten times in a quarter of
# an hour — and docker/prod/.env.example leaves it commented out.
RATE_LIMIT_PRINCIPAL_HASH_MAX=100
RATE_LIMIT_PRINCIPAL_HASH_WINDOW=15m
# Comma-separated allow-list; empty means "no browser origin allowed".
# Defaults below are the two SPA dev servers: admin on 3001 and customer on 3002
# (ADR-0055 §1 took 3002 from `web`, which is marketing only; its placeholder was
# deleted at `D14.1` and the marketing deliverable picks its own port).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Impersonation (ADR-0057) ─────────────────────────────────────────────────
# Same duration form as the auth TTLs above (s, m, h, d), parsed to seconds at
# startup.
#
# The session's end is **fixed** at the exchange and refresh does not extend it,
# so this is how long a staff member may act as a customer before re-minting;
# the access token's exp is capped by it, so no credential outlives the window.
IMPERSONATION_SESSION_TTL=30m
# The one-time handoff token, delivered to the customer app in a URL fragment.
# Seconds by design: it is the only credential here that rides in a URL, and it
# is single-use with no rotation grace, so the mint-to-exchange window is all
# an onlooker gets.
IMPERSONATION_HANDOFF_TTL=60s

# ─── Organizations (ADR-0067 §2) ──────────────────────────────────────────────
# How long an invitation stays acceptable. The same duration form as the TTLs
# above, ceilinged at 30d.
#
# Days rather than minutes because the window is measured against a person's
# inbox: an invitation has to be read, considered and acted on. It is not a
# credential window — D15 sends no mail, so acceptance matches by address and
# the token on the row is written by the create path and read by nothing until
# the mail deliverable adds the send.
#
# `expired` is a state no sweeper writes — it becomes true as the clock passes
# — so an unbounded TTL would leave an invited address acceptable forever with
# nothing to notice it. That is why there is a ceiling and not only a default.
ORGANIZATION_INVITATION_TTL=7d

# ─── Mail flows (ADR-0071 §1) ─────────────────────────────────────────────────
# Where each SPA answers. The API builds every link it mails out of these — the
# verification link, both reset links, the address confirmation, the invitation
# and the staff onboarding link — so it has to learn the two origins; a client
# cannot supply the origin its own link points at, or an unauthenticated caller
# would choose where a credential is delivered.
#
# These are the defaults, so a fresh clone mails clickable links with nothing
# set. **NODE_ENV=production refuses both of these exact values**, the way it
# refuses TRUST_PROXY's: a deployment that inherited them would mail every link
# into the recipient's own machine, and only the recipient would find out.
CUSTOMER_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3001
# How long each kind of link stays redeemable. The duration form of the TTLs
# above (s, m, h, d), parsed to seconds at startup.
#
# Four numbers because the four questions differ: a verification link is read
# whenever the person next opens their mail; a reset link is a credential they
# asked for a minute ago; an address change is takeover-enabling, so it is held
# to the reset's standard rather than the verification's; and a staff onboarding
# link goes to somebody who may not start until Monday.
#
# No ceiling, unlike the two impersonation windows — nothing here rests on a
# phrase a typo could retire. Widening one is choosing a weaker mitigation
# deliberately (ADR-0071 §1: for a token in a fragment, the TTL *is* the
# mitigation).
VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
EMAIL_CHANGE_TOKEN_TTL=1h
STAFF_ONBOARDING_TOKEN_TTL=7d

# ─── Sign in with Google (ADR-0072) ───────────────────────────────────────────
# This API's own public origin. The OIDC redirect URI is composed from it,
#
#   ${API_PUBLIC_URL}/api/v1/public/auth/google/callback
#
# and must be registered, character for character, as an authorized redirect
# URI of the OAuth client in the Google Cloud console (docs/deploy.md). The
# default is the dev server, so a local client registers
# http://localhost:4000/api/v1/public/auth/google/callback. **NODE_ENV=
# production refuses a loopback or plain-http value**, the way it refuses the
# two app URLs above: Google sends the person's browser here carrying a
# single-use authorization code.
API_PUBLIC_URL=http://localhost:4000
# The OAuth client — a "Web application" client under APIs & Services →
# Credentials. **Both or neither.** Unset (the default) leaves the three
# sign-in routes unmounted, answering 404 exactly as registration does with its
# flag off; half a pair is refused at startup. The secret is a credential: it
# belongs in the untracked `.env` and never in a committed file or a VITE_
# variable — the code exchange is server to server and no browser sees it.
# The customer app's button is a flag of its own, VITE_FEATURE_GOOGLE_SIGN_IN
# in apps/customer/.env: set it beside these two, never instead of them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The key the sign-in transaction cookie and its handoff binding are signed
# under (ADR-0078 §2). Optional: unset, it is derived from JWT_ACCESS_SECRET
# under a label of its own, so the two never share a key; set, it rotates on
# its own — changing it fails only the sign-ins in flight at that moment.
# Min 32 characters, different from both access secrets.
# OIDC_TRANSACTION_SECRET=
# The handoff the Google callback gives the customer app in a redirect's
# fragment, exchanged once for a session. The impersonation handoff's sixty
# seconds for its reason — a bearer credential in a URL — and ceilinged at 5m
# for the same one.
FEDERATED_HANDOFF_TTL=60s

# ─── Mail (ADR-0066 §1) ───────────────────────────────────────────────────────
# The port ships with two adapters and D18's flows use them (ADR-0071).
#
#   log    writes one line per message (recipient and subject, never the body)
#          and delivers nothing. The schema's own default, so a deployment that
#          says nothing gets it — outside production, which refuses silence.
#   smtp   nodemailer against SMTP_*. Locally that is Mailpit above, where the
#          message appears at http://localhost:8025.
#
# **`smtp` here, and that is a change of `D18.4`.** The example used to ship
# `log` on the ground that a fresh clone should need no mail server; from the
# step that made the browser tier read its links, `pnpm test:e2e` cannot prove
# a single one of these flows without a mailbox, and `pnpm docker:up` starts
# Mailpit beside Postgres anyway. So the documented local setup is one that can
# read its own mail. `pnpm test` still needs none — the API's suites drive a
# capturing port, never a transport.
#
# **NODE_ENV=production refuses an unstated transport.** A deployment that
# inherited `log` would swallow every message it ever sent, silently.
MAIL_TRANSPORT=smtp
MAIL_FROM=no-reply@machxi.local
# Mailpit's defaults. It accepts any credentials, so the two below can stay
# unset; a real relay needs both or neither (half a pair sends an empty AUTH).
SMTP_HOST=localhost
SMTP_PORT=1025
# Implicit TLS (port 465). `false` still upgrades through STARTTLS.
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ─── Observability (ADR-0066 §2, §3) ──────────────────────────────────────────
# GET /metrics is Prometheus text, mounted beside /health and outside every
# rate limiter (an operational endpoint that can be throttled takes a working
# instance out of rotation). Unset means unauthenticated, which is fine on a
# laptop and refused at startup when NODE_ENV=production: the body is numbers,
# but the numbers name every route the API has. At least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# METRICS_TOKEN=
# Turns the error-reporting seam on. Unset means no reporter is built and the
# adapter module is never even evaluated. It fires on 5xx only — a 400, a 401
# or a 409 is the API working — and is given the request id, the route
# pattern, the status and the principal, never the request body.
# ERROR_REPORTING_DSN=

# ─── Shared rate-limit state (ADR-0066 §4) ────────────────────────────────────
# Unset means the in-memory store, which counts per process: correct for one
# instance, and N times every limit above for N of them. Set it and all four
# limiters share one budget. `redis:` or `rediss:` only.
#
# A configured Redis that cannot be reached fails the limiters **closed** —
# requests are refused, not admitted — and the process refuses to start at all
# if the first connection fails.
# REDIS_URL=redis://localhost:6379

# ─── Features ─────────────────────────────────────────────────────────────────
# Enables POST /api/v1/public/auth/register.
FEATURE_USER_REGISTRATION=true

# ─── Seeds (ADR-0008) ─────────────────────────────────────────────────────────
# `pnpm db:seed` creates/updates exactly this one super admin; it is idempotent
# and skipped when either value is missing. Min 12 characters.
SEED_SUPER_ADMIN_EMAIL=admin@machxi.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!local

# ─── The browser tier (ADR-0052, D10.4) ───────────────────────────────────────
# `pnpm test:e2e` signs in as the account seeded above — the two variables are
# its credentials, so a machine that seeded something else needs no extra
# configuration. Nothing new is required here.
#
# E2E_BASE_URL is optional and defaults to the dev server's http://localhost:3001.
# It is a test-runner input rather than application configuration (ADR-0004): no
# code in apps/ or packages/ reads it, and the suite is the only consumer.
# E2E_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# The browser app has its own file: apps/admin/.env (ADR-0033). It cannot live
# here, because Vite reads env from the app directory and inlines VITE_* into
# the served bundle -- which is also why nothing secret may go in it. Copy
# apps/admin/.env.example alongside this one.
# ---------------------------------------------------------------------------
