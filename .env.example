# Root environment file — copy to `.env` and edit (ADR-0004).
#
#   cp .env.example .env
#
# One file feeds three consumers, which is why it lives at the root and not in
# apps/api:
#   * docker compose  → POSTGRES_* (docker/local/compose.yaml, ADR-0007)
#   * the API         → everything in the `core/config` zod schema (ADR-0004)
#   * db tooling      → DATABASE_URL (drizzle.config.ts, migrate, seeds, ADR-0008)
#
# `.env` is git-ignored; this file is committed and must list every variable
# with a safe default. Adding a variable is a three-place change: zod schema,
# this file, deployment secret store.

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Required — there is no default. Every production guard branches on it, so an
# absent NODE_ENV would silently mean "development": the committed signing key
# accepted, `*` allowed as a CORS origin, stack traces in error responses.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Injected at build time in real deployments; falls back to package.json.
APP_VERSION=0.0.0
# GIT_SHA=
# Express `trust proxy` value: false | a hop count | a CIDR list | loopback.
# Keep it false locally; behind a load balancer set the number of proxies.
# `true` is refused when NODE_ENV=production: it makes Express take the
# left-most X-Forwarded-For entry verbatim, so req.ip becomes attacker-
# controlled — and req.ip is what the login rate limit and the session audit
# trail depend on (ADR-0020).
TRUST_PROXY=false

# ─── Postgres (docker compose only) ───────────────────────────────────────────
# These create the container's superuser and default database on first start.
# Changing them after the volume exists has no effect — `pnpm docker:reset`.
POSTGRES_USER=machxi
POSTGRES_PASSWORD=machxi
POSTGRES_DB=machxi
# Host port. Change this (not the container port) if 5432 is already taken,
# and update the host/port in DATABASE_URL(_TEST) to match.
POSTGRES_PORT=5432

# ─── Database (API + tooling) ─────────────────────────────────────────────────
DATABASE_URL=postgres://machxi:machxi@localhost:5432/machxi
# Tooling-only, not part of the API config schema: the integration test run
# migrates, truncates and re-seeds this database (ADR-0021). Created by
# docker/local/postgres/init/01-test-db.sql.
DATABASE_URL_TEST=postgres://machxi:machxi@localhost:5432/machxi_test
DB_POOL_MAX=10
DB_CONNECT_RETRIES=10

# ─── Auth (ADR-0018) ──────────────────────────────────────────────────────────
JWT_ISSUER=machxi-api
# Min 32 characters. The value below is a placeholder for local development —
# generate a real one per environment and never commit it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# This value is listed in KNOWN_PUBLIC_SECRETS and is refused outright when
# NODE_ENV=production, along with the one in apps/api/.env.test.
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me
# Durations: a positive integer followed by s, m, h or d (at most 365d). Parsed
# to seconds at startup, so a typo fails there rather than at the first login.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
# Window in which the previous refresh token still works, so a lost response or
# a double-tap does not log the user out. Outside it, a replayed token is
# treated as stolen and the session is revoked (ADR-0018 §Refresh).
REFRESH_ROTATION_GRACE_SEC=30
# How many argon2 hashes may run at once. Each holds one libuv thread and
# 64 MiB for ~130 ms, so an uncapped login endpoint starves DNS and filesystem
# work process-wide (ADR-0020 §Hashing cost vs. liveness). Requests beyond the
# cap queue; beyond eight queued per slot they are shed with 503 + Retry-After.
# Raise this together with UV_THREADPOOL_SIZE below, never on its own.
AUTH_MAX_CONCURRENT_HASHES=4

# ─── Password hashing (ADR-0018, @repo/crypto defaultArgon2Params) ────────────
# argon2id. Values below the OWASP floor (19456 / 2 / 1) are rejected at
# startup and by the seeders, so lowering these to speed up tests will fail.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Not read by the API — a Node runtime knob. Each hash occupies one libuv
# thread for ~130 ms, and the default pool is 4, so deployments expecting
# concurrent logins raise this (ADR-0020 §Hashing cost vs. liveness).
# UV_THREADPOOL_SIZE=8

# ─── HTTP security (ADR-0020) ─────────────────────────────────────────────────
# Per 15 minutes. The global one is keyed on IP and covers /api; the login one
# is keyed on IP + email and also covers registration; the refresh one is keyed
# on IP and counts **failed** refreshes only, so a client refreshing normally
# never spends its budget. /health is outside all three (ADR-0016, ADR-0020).
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_MAX=5
# Comma-separated allow-list; empty means "no browser origin allowed".
# Defaults below are the admin (ADR-0022) and web dev servers.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Features ─────────────────────────────────────────────────────────────────
# Enables POST /api/v1/public/auth/register.
FEATURE_USER_REGISTRATION=true

# ─── Seeds (ADR-0008) ─────────────────────────────────────────────────────────
# `pnpm db:seed` creates/updates exactly this one super admin; it is idempotent
# and skipped when either value is missing. Min 12 characters.
SEED_SUPER_ADMIN_EMAIL=admin@machxi.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!local
