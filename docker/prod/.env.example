# Values for docker/prod/compose.yaml (ADR-0059 §6).
#
#   cp docker/prod/.env.example docker/prod/.env
#
# Compose reads `.env` from the directory the compose file lives in, so no
# `--env-file` flag is needed. On a platform (Coolify, see `docs/deploy.md`)
# these are entered as environment variables instead and this file is only the
# checklist of what must be set.
#
# `.env` here is git-ignored, like every other `.env` in the repository. This
# file is committed and must therefore contain **no real value** — every
# secret below is a placeholder that the API refuses in production.

# ─── The external resources (not run by this compose file) ────────────────────
# Managed Postgres, as **two roles** (ADR-0061 §1). Provision them once on the
# managed instance — see docs/deploy.md; the compose file does not create them,
# and migration 0008 refuses to run if the application role is missing.
#
#   machxi_app    what the API connects as: SELECT/INSERT/UPDATE/DELETE, no
#                 DDL, no ownership, and no UPDATE or DELETE on audit_events.
#   machxi_owner  what the one-shot migrate service connects as. It runs DDL
#                 and nothing else in the deployment uses it.
DATABASE_URL=postgres://machxi_app:password@db.internal:5432/machxi
DATABASE_URL_OWNER=postgres://machxi_owner:password@db.internal:5432/machxi
# Managed Redis. Nothing reads it yet — ADR-0066 §4 fills the seam at `D14.6`.
REDIS_URL=

# ─── The API ──────────────────────────────────────────────────────────────────
# Required, and refused as both "true" and "false" (ADR-0059 §7): state the
# hop. Behind a single reverse proxy — which is what a platform gives you —
# that is 1.
TRUST_PROXY=1
# Min 32 characters. **The placeholder below is refused**: it is committed, so
# it is public, and every key committed to this repository is enumerated in
# `KNOWN_PUBLIC_SECRETS` and rejected outright when NODE_ENV=production
# (ADR-0020 §Known-public secrets). Replacing it is the one step of this file
# that cannot be skipped, including for a local trial of the images.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url
# The exact origins the two SPAs are served from. No wildcard, no trailing
# slash, no path (ADR-0020).
CORS_ORIGINS=https://admin.example.com,https://app.example.com
LOG_LEVEL=info
APP_VERSION=0.0.0
# GIT_SHA=

# ─── The two SPAs, built per environment ──────────────────────────────────────
# Vite inlines these, so they are build arguments and changing one means
# rebuilding the image (ADR-0059 §4). Two names for the API URL because the two
# apps are two origins that will not always answer to the same host (ADR-0033).
VITE_ADMIN_API_URL=https://api.example.com
VITE_CUSTOMER_API_URL=https://api.example.com
# Where apps/customer answers. The admin's Impersonate action opens
# `<this>/impersonate#token=…` (ADR-0057 §7).
VITE_CUSTOMER_APP_URL=https://app.example.com

# ─── Published ports and image names ──────────────────────────────────────────
# The ports are bound to 127.0.0.1 by the compose file, so they are reachable
# from the host and from nowhere else — a published port is a DNAT rule that
# sits in front of the host firewall, and the API must answer behind the
# platform's proxy rather than beside it. A platform routes by domain over the
# compose network and needs none of them.
API_PORT=4000
ADMIN_PORT=3001
CUSTOMER_PORT=3002
IMAGE_PREFIX=machxi
IMAGE_TAG=local
