# Values for docker/prod/compose.yaml (ADR-0059 §6).
#
#   cp docker/prod/.env.example docker/prod/.env
#
# Compose reads `.env` from the directory the compose file lives in, so no
# `--env-file` flag is needed. On a platform (Coolify, see `docs/deploy.md`)
# these are entered as environment variables instead and this file is only the
# checklist of what must be set.
#
# `.env` here is git-ignored, like every other `.env` in the repository. This
# file is committed and must therefore contain **no real value** — every
# secret below is a placeholder that the API refuses in production.

# ─── The external resources (not run by this compose file) ────────────────────
# Managed Postgres, as **two roles** (ADR-0061 §1). Provision them once on the
# managed instance — see docs/deploy.md; the compose file does not create them,
# and migration 0008 refuses to run if the application role is missing.
#
#   machxi_app    what the API connects as: SELECT/INSERT/UPDATE/DELETE, no
#                 DDL, no ownership, and no UPDATE or DELETE on audit_events.
#   machxi_owner  what the one-shot migrate service connects as. It runs DDL
#                 and nothing else in the deployment uses it.
DATABASE_URL=postgres://machxi_app:password@db.internal:5432/machxi
DATABASE_URL_OWNER=postgres://machxi_owner:password@db.internal:5432/machxi
# Managed Redis — the shared rate-limit store (ADR-0066 §4). Leave it empty for
# a single instance; set it the moment there are two, or each of them gets its
# own copy of every limit. `redis:` or `rediss:` only, and an unreachable one
# stops the API from starting rather than quietly removing the limits.
REDIS_URL=

# ─── The API ──────────────────────────────────────────────────────────────────
# Required, and refused as both "true" and "false" (ADR-0059 §7): state the
# hop. Behind a single reverse proxy — which is what a platform gives you —
# that is 1.
TRUST_PROXY=1
# The three socket deadlines (ADR-0073 §4). Omit them to take the schema's
# 30s / 10s / 65s, which is what this file does for the first two.
#
# **The keep-alive is the one to check against your proxy**, and it is set here
# rather than commented out for that reason: Node's own default is 5s and a
# reverse proxy typically holds an idle connection for 60s, so an API on the
# default closes connections the proxy is about to reuse — intermittent 502s in
# front of a perfectly healthy process. 65s is above the common 60; if your
# proxy holds longer, raise this above it, so the proxy is always the end that
# closes.
# HTTP_REQUEST_TIMEOUT=30s
# HTTP_HEADERS_TIMEOUT=10s
HTTP_KEEP_ALIVE_TIMEOUT=65s
# How many live sessions one account may hold (ADR-0073 §3). Omit it to take
# the schema's 10: the eleventh sign-in revokes the oldest rather than refusing
# the new one, and `0` turns the cap off — which leaves the growth for
# `db:sessions:prune` alone, the way it was before this variable existed.
# AUTH_MAX_SESSIONS_PER_PRINCIPAL=10
# How long the `prune` service waits between retention sweeps (ADR-0073 §3).
# A `sleep` duration — `24h`, `6h`, `900` — read by the compose file's loop and
# by nothing in the API: it is not a config-schema variable, which is why it
# has no `.env.example` twin at the repository root. Omit it to take a day.
# A deployment whose platform runs scheduled jobs of its own should run
# `node dist/prune-sessions.js` that way and drop the service instead.
# PRUNE_INTERVAL=24h
# Min 32 characters. **The placeholder below is refused**: it is committed, so
# it is public, and every key committed to this repository is enumerated in
# `KNOWN_PUBLIC_SECRETS` and rejected outright when NODE_ENV=production
# (ADR-0020 §Known-public secrets). Replacing it is the one step of this file
# that cannot be skipped, including for a local trial of the images.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url
# The exact origins the two SPAs are served from. No wildcard, no trailing
# slash, no path (ADR-0020).
CORS_ORIGINS=https://admin.example.com,https://app.example.com
LOG_LEVEL=info
# The brand every cookie name and the JWT audience derive from, and the same
# word both SPA images are built with (ADR-0064 §1). A FORK-DAY VALUE: changing
# it after launch signs every browser out and orphans every device preference
# (§2). Set it here once, before the first deployment.
APP_ID=machxi
APP_VERSION=0.0.0
# GIT_SHA=
# Where each SPA answers, as the **API** reads them: it builds every link it
# mails out of these (ADR-0071 §1). **Required in production** — the schema
# refuses the committed development defaults (http://localhost:3002 / :3001),
# because a deployment that inherited them would mail every verification, reset
# and invitation link into the recipient's own machine.
#
# Not the same variables as the VITE_ ones below, although two of them carry the
# same value: those are inlined into a browser bundle at build time, these are
# read by the API at startup.
# **https and not a loopback address**, both enforced at startup: these links
# carry single-use tokens that can take an account over, so plain http would put
# one in the browser bar and on the wire in the clear.
CUSTOMER_APP_URL=https://app.example.com
ADMIN_APP_URL=https://admin.example.com
# The API's own public origin (ADR-0072 §2). **Required in production** by the
# same check as the two above: the OIDC redirect URI is composed from it, and
# the identity provider sends the person's browser there carrying a single-use
# authorization code. Required whether or not Google is configured — it is a
# fact about the deployment, and refusing the development default everywhere
# is what keeps a later GOOGLE_CLIENT_ID from quietly inheriting it.
API_PUBLIC_URL=https://api.example.com
# Sign in with Google, **both or neither** (ADR-0072 §2). Unset leaves the
# three routes unmounted (404); half a pair is refused at startup. The client
# is a "Web application" OAuth client whose one authorized redirect URI is
# `<API_PUBLIC_URL>/api/v1/public/auth/google/callback` — see docs/deploy.md.
# The secret is a credential: a platform's secret store, never this file.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The sign-in handoff's window. Omit it to take the schema's 60s; the ceiling
# is 5m, for the reason the impersonation handoff has one.
# FEDERATED_HANDOFF_TTL=60s
# The reset limiter's budget and the hour it is per (ADR-0071 §4). Omit both to
# take the schema's 3/hour — an anti-abuse number rather than a capacity one,
# because a `forgot` costs the *victim* a message in their inbox.
# RATE_LIMIT_PASSWORD_RESET_MAX=3
# RATE_LIMIT_PASSWORD_RESET_WINDOW=1h
# The mailbox's own budget over that same window, keyed on the address with no
# IP in the key (ADR-0071 §4). Omit it to take the schema's 5: the 3 above is
# what one *sender* may mail one mailbox, and this is what the mailbox receives
# from everybody. Raise it only with the inbox in mind, not the caller.
# RATE_LIMIT_MAILBOX_MAX=5
# The source's own budget over that window, keyed on the caller's address with
# no email in the key (ADR-0071 §4, amended at `D18.7`) — what one source may
# mail in total, however many addresses it names, which is the walk the two
# above cannot see because both of their keys move with the address.
# **The one number here that is a capacity number, and the one line in this
# group that is set rather than commented out.** The schema's default is 20,
# which is sized for one person; the key is a source address, so behind a
# carrier-grade NAT, a corporate egress or a mobile carrier that is thousands
# of people sharing a single budget across `password/forgot` on both segments,
# `resend-verification` and `register` together — and a deployment that
# inherited the default would answer `429` to legitimate sign-ups without
# anybody having chosen that. 150 is the deliberate number: far above what one
# honest person produces in an hour and still a ceiling on a walk through
# strangers' mailboxes. Size it against your own traffic — raise it if
# legitimate sign-ups or recovery requests start answering `429`, lower it
# toward the schema's default if every caller has an address of their own.
RATE_LIMIT_MAIL_SOURCE_MAX=150
# The per-principal budget on every authenticated route that verifies a
# password (ADR-0073 §1). Omit both to take the schema's 10 / 15m: it is
# an anti-abuse number rather than a capacity one — the key is one account, and
# nobody changes their password ten times in a quarter of an hour.
# RATE_LIMIT_PRINCIPAL_HASH_MAX=10
# RATE_LIMIT_PRINCIPAL_HASH_WINDOW=15m
# The four link lifetimes (ADR-0071 §1). Omit them to take the schema's own
# 24h / 1h / 1h / 7d, which is what this file does — they are sized by what the
# recipient is being asked to do, not by the deployment.
# VERIFICATION_TOKEN_TTL=24h
# PASSWORD_RESET_TOKEN_TTL=1h
# EMAIL_CHANGE_TOKEN_TTL=1h
# STAFF_ONBOARDING_TOKEN_TTL=7d
# Required in production and refused when unstated (ADR-0066 §1): `log` writes
# a line per message and delivers nothing, `smtp` uses the SMTP_* group below.
#
# **`log` is no longer an honest answer once D18's flows are deployed** — a
# customer who cannot verify their address cannot sign in at all (ADR-0071 §3).
# Set `smtp` and the group below, or the deployment has no registration.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Required in production (ADR-0066 §2). **The empty value below is refused**,
# like the signing key above and for a milder reason: GET /metrics answers
# unauthenticated without a token, and its body names every route the API has.
# At least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=
# Optional (ADR-0066 §3). Absent means no reporter is built and the adapter
# module is never evaluated; set, it fires on 5xx only.
# ERROR_REPORTING_DSN=
# Self-service registration (ADR-0004, ADR-0067 §6). Unset means `true`, which
# is what ADR-0018 decided; `false` unmounts POST /public/auth/register, so the
# path answers ROUTE_NOT_FOUND rather than a 403 that would confirm the feature.
#
# **One variable for both halves.** The compose file feeds it to the API and,
# as VITE_FEATURE_USER_REGISTRATION, into the customer image's build — so the
# screen and the endpoint cannot disagree. Setting it here means rebuilding the
# customer image, because Vite inlines its half.
# FEATURE_USER_REGISTRATION=false

# ─── The two SPAs, built per environment ──────────────────────────────────────
# Vite inlines these, so they are build arguments and changing one means
# rebuilding the image (ADR-0059 §4). Two names for the API URL because the two
# apps are two origins that will not always answer to the same host (ADR-0033).
VITE_ADMIN_API_URL=https://api.example.com
VITE_CUSTOMER_API_URL=https://api.example.com
# Where apps/customer answers. The admin's Impersonate action opens
# `<this>/impersonate#token=…` (ADR-0057 §7).
VITE_CUSTOMER_APP_URL=https://app.example.com
# "Continue with Google" in the customer app (ADR-0072 §4). The SPA's half of
# the switch whose other half is GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET on
# the API: set it true in the same change that gives the API both, and rebuild
# the customer image. With it true and no client on the API, the button meets
# 404 and says so — the API is the control.
VITE_FEATURE_GOOGLE_SIGN_IN=false

# ─── Published ports and image names ──────────────────────────────────────────
# The ports are bound to 127.0.0.1 by the compose file, so they are reachable
# from the host and from nowhere else — a published port is a DNAT rule that
# sits in front of the host firewall, and the API must answer behind the
# platform's proxy rather than beside it. A platform routes by domain over the
# compose network and needs none of them.
API_PORT=4000
ADMIN_PORT=3001
CUSTOMER_PORT=3002
IMAGE_PREFIX=machxi
IMAGE_TAG=local
