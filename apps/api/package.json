{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.cjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.0",
    "supertest": "^7.1.0",
    "tsdown": "0.12.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
