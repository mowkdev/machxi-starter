{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qs": "^6.15.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "5.0.6",
    "@types/node": "^22.15.3",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "supertest": "^7.1.0",
    "tsdown": "0.12.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
