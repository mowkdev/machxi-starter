{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsdown",
    "check-types": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@repo/contracts": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qs": "^6.16.0",
    "rate-limit-redis": "^6.0.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "catalog:",
    "supertest": "^7.2.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
