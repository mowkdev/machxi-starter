# Test environment for the API's integration run (ADR-0004 §File layout).
#
# Committed on purpose: it holds no real secret, and CI must get the same
# values a developer gets. It is the third of the three env files —
# `.env.example` documents, root `.env` runs the stack, this one runs vitest.
#
# `DATABASE_URL` is deliberately absent. `test/setup/env.ts` derives it from
# `DATABASE_URL_TEST`, so there is exactly one database name in this file and
# no way for the suite to point the API at the development database. This file
# wins over the root `.env` for the test run (ADR-0004, amended 2026-08-18).

NODE_ENV=test

# Pinned rather than left to the schema's default (ADR-0064 §1), because
# `test/setup/env.ts` loads this file with `override: true` and the integration
# tier asserts `__Secure-machxi.refresh` and `__Host-machxi.csrf.*` by literal
# name. An `APP_ID` exported in a shell — or side-loaded from the root `.env`,
# which anything touching `@repo/db`'s tooling does — would rename every cookie
# and turn the whole auth, CSRF and impersonation tier into "cookie was not
# set" failures that name nothing. Same argument as the `DATABASE_URL`
# overwrite in that file, and `scripts/rename.mjs` rewrites this value too.
APP_ID=machxi

# The suite migrates, truncates and re-seeds this database on every run, and
# refuses any URL whose database name does not end in `_test` (ADR-0008).
#
# Two roles, not one (ADR-0061 §1). The suite itself runs as `machxi_app` —
# the role the API connects as in production, with table privileges and no DDL
# — and the harness migrates and truncates as `machxi_owner`. That split is
# what makes a missing grant fail here rather than in a deployment: every query
# a test makes carries exactly the privileges production has.
DATABASE_URL_TEST=postgres://machxi_app:machxi_app@localhost:5432/machxi_test
DATABASE_URL_TEST_OWNER=postgres://machxi_owner:machxi_owner@localhost:5432/machxi_test

# Errors only: a passing run should print test output, not access logs.
LOG_LEVEL=error

# PORT is deliberately absent: supertest drives the app object directly and
# nothing in the suite binds a socket, so the schema default stands (ADR-0021).

# Dummy, but a *different* dummy from the one in `.env.example`: a test that
# accidentally verified a token signed with the documented placeholder would
# pass against a misconfigured production deployment too.
JWT_ACCESS_SECRET=test-only-signing-key-do-not-use-anywhere-else
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_ROTATION_GRACE_SEC=30

# The OWASP floor `@repo/crypto` enforces (19456/2/1), not the production
# default: the auth suite hashes on nearly every test, and the cost of argon2
# is that package's to prove, not this suite's. Anything lower is rejected.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

CORS_ORIGINS=http://localhost:3001
FEATURE_USER_REGISTRATION=true

# The mail port's default transport (ADR-0066 §1), stated rather than inherited
# so the suite is explicit about it: no test may open an SMTP connection, and
# `log` is what a developer's machine and CI both have. `REDIS_URL`,
# `ERROR_REPORTING_DSN` and `METRICS_TOKEN` are deliberately absent and are
# *deleted* by `test/setup/env.ts` — see the note there.
MAIL_TRANSPORT=log

# Effectively off for the suite. The auth tests log in dozens of times from one
# address, which the production limit of 10 per 15 minutes would (correctly)
# refuse. The limiters themselves are covered by a dedicated test that builds
# an app with a low override — an in-memory store lives per app instance, so
# that test cannot leak counts into any other file (ADR-0020, ADR-0021).
RATE_LIMIT_GLOBAL_MAX=100000
RATE_LIMIT_LOGIN_MAX=100000
RATE_LIMIT_REFRESH_MAX=100000
# Off for the same reason and by the same means: the impersonation suite mints
# repeatedly as one staff member, which this limiter's per-actor key (ADR-0057
# §1) would correctly refuse at ten. The limiter itself is covered by the
# dedicated low-override test, not by leaving a real budget in place here.
RATE_LIMIT_IMPERSONATION_MAX=100000

# The suite runs many logins concurrently through one process; the cap exists
# to protect the libuv pool, and at test parameters (19 MiB, t=2) queueing
# would only slow the run down.
AUTH_MAX_CONCURRENT_HASHES=16

# Seeded per integration file through the real seeders (ADR-0008), so the
# fixtures the tests sign in as are exactly the ones `pnpm db:setup` creates.
# `.local` is unregistrable (RFC 6762) and `--dev` refuses to run in production.
SEED_SUPER_ADMIN_EMAIL=admin@machxi.local
SEED_SUPER_ADMIN_PASSWORD=TestSuperAdmin!123
