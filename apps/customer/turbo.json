{
  "extends": ["//"],
  "tasks": {
    // No cached output: this app type-checks without emitting (ADR-0062
    // §3), and `tsc -b`'s incremental state is deliberately kept outside
    // `dist-types/` (ADR-0073 §6, and `tsconfig.json` beside this file), so
    // there is nothing here for the cache to restore — least of all the note
    // that would tell the compiler the check had already been done. Cached
    // all the same, unlike the packages' task in the root table (ADR-0078
    // §6): a hit replays a green for inputs that were checked, and restores
    // nothing the compiler reads.
    "check-types": {
      "cache": true,
      "outputs": []
    },
    "build": {
      "outputs": ["dist/**"],
      "env": [
        "VITE_API_URL",
        "VITE_APP_ID",
        "VITE_I18N_PSEUDO",
        "VITE_FEATURE_USER_REGISTRATION",
        "VITE_FEATURE_GOOGLE_SIGN_IN",
        "VITE_ERROR_REPORTING_DSN"
      ]
    },
    "dev": {
      "env": [
        "VITE_API_URL",
        "VITE_APP_ID",
        "VITE_I18N_PSEUDO",
        "VITE_FEATURE_USER_REGISTRATION",
        "VITE_FEATURE_GOOGLE_SIGN_IN",
        "VITE_ERROR_REPORTING_DSN"
      ]
    }
  }
}
