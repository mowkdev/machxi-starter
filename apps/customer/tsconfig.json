{
  "extends": "@repo/typescript-config/vite.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "incremental": true,
    // Beside the cached output, never inside it (ADR-0073 §6). `check-types`
    // once cached `dist-types/**`, and a buildinfo kept there was restored by the
    // task whose result it decides: `tsc -b` reads "nothing to do" and exits
    // `0` having checked nothing, and Turborepo caches that green. Here the
    // compiler's memory is machine-local and gitignored (`*.tsbuildinfo`), so
    // a restored cache can never answer for a run.
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  },
  "include": [
    "src",
    "e2e",
    "app-version.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/account"
    },
    {
      "path": "../../packages/api-client"
    },
    {
      "path": "../../packages/app-kit"
    },
    {
      "path": "../../packages/app-services"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/form"
    },
    {
      "path": "../../packages/i18n"
    },
    {
      "path": "../../packages/resource"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/config-vitest"
    }
  ]
}
