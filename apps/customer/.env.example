# apps/customer — the customer app's configuration (ADR-0033 §Configuration,
# as carried by ADR-0051; the app itself is ADR-0055).
#
# Everything here is COMPILE-TIME PUBLIC. Vite inlines `VITE_*` variables into
# the served bundle, so anyone who loads the page can read them: nothing secret
# may ever be added to this file or to the zod schema in `src/shared/config`.
# That is what "configuration of a browser app" means, and writing it down is
# what keeps a future API key out of it.
#
# A second file rather than a shared one, for the reason `apps/admin` has its
# own (ADR-0033): a browser app's configuration is the app's, and the two SPAs
# are two origins that will not always answer to the same API host.

# Where the API answers. No trailing path — the client appends `/api/v1/user`
# itself (ADR-0015: this app talks to the user segment and nothing wider, which
# is the one line that differs from the admin's copy of this file).
#
# The dev default is deliberately cross-origin rather than a Vite proxy, so the
# machinery production depends on — CORS preflights against CORS_ORIGINS,
# credentialed requests, Secure cookies on localhost — is exercised on a
# developer's machine on day one (ADR-0033 §Development runs the deployed shape).
# The root `.env.example` already lists http://localhost:3002 in CORS_ORIGINS.
VITE_API_URL=http://localhost:4000

# The brand every device-storage key this app writes is prefixed with
# (ADR-0064 §1): `<VITE_APP_ID>.user.theme`, `.locale`. It must be
# the same word as the API's APP_ID — the two are halves of one identity, and
# a deployment whose API says `acme` and whose SPA says `machxi` has cookies
# from one brand and preferences from another.
#
# A FORK-DAY VALUE (§2): changing it after launch orphans every device
# preference, and changing APP_ID beside it signs every browser out. Set both
# once, before the first deployment, and run `node scripts/rename.mjs <name>`
# for the mechanical half.
VITE_APP_ID=machxi

# The dev-only pseudo-locale (ADR-0046 §10). Unset or `false` everywhere except
# a build made to hunt for untranslated copy: it post-processes the English
# catalogue into `[Šààṽḛḛ ͼḥααṇḡḛḛṡ]` — accented so a hardcoded string stands out,
# widened so a layout that will break under a longer language breaks here first.
#
# It is NOT a locale: `LOCALES` is the production set and lives in a database
# column, and an account cannot be set to a lens over English.
VITE_I18N_PSEUDO=false

# The error-reporting seam (ADR-0066 §3). Unset in a default build, and the
# absence is what the code branches on: no reporter is built and the adapter
# chunk is never downloaded. Set it and the top-level boundary reports through
# `src/shared/error-reporting`, whose `reporter.ts` is the one file a fork
# edits to wire an actual SDK — this repository ships none.
#
# A DSN is an ingest address, not a credential, which is why it may live in a
# file this app inlines into the bundle. Everything else in the note at the top
# still holds.
# VITE_ERROR_REPORTING_DSN=
