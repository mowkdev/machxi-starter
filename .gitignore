.DS_Store
node_modules
.turbo
*.log
.next
dist
# The declarations-only emit `tsc -b` writes (D14.9, ADR-0062 §3). Nothing at
# runtime resolves to it: Vite and tsdown still read each package's `src`.
dist-types
dist-ssr
*.local
.env
.env.*
!.env.example
!.env.test
.cache
server/dist
public/dist
coverage
*.tsbuildinfo
.claude/settings.local.json
# Worktrees Claude Code creates beside the checkout; each is its own branch.
.claude/worktrees/

# Scratch the TanStack Router plugin writes while `dev` is running (D4.2), one
# per SPA (`apps/customer` joined at D12.1).
apps/admin/.tanstack
apps/customer/.tanstack

# Playwright (D10.4): a live refresh cookie, its reports and its traces
# (`apps/customer` joined at D12.10, with its own config and its own run)
apps/admin/e2e/.auth/
apps/admin/test-results/
apps/admin/playwright-report/
apps/customer/test-results/
apps/customer/playwright-report/

# The desktop app's session outputs (`Claude outputs/`): notes a session
# writes for the operator beside the repository, never part of it. Ignored
# here, in .prettierignore (format:check walks untracked files too) and in
# .dockerignore.
Claude outputs/
