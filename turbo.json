{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "outputs": [
        "build/**",
        ".vercel/**",
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": [],
      "env": [
        "APP_ID",
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_OWNER",
        "DB_*",
        "REDIS_URL",
        "ERROR_REPORTING_DSN",
        "METRICS_TOKEN"
      ]
    },
    // A workspace's unit suite runs its workspace dependencies' source — a
    // package is source-only, and the shared Vitest config is a package — so
    // its hash must cover their inputs, or a change in `@repo/grid` replays a
    // stale green for the app that exercises it (ADR-0026 as carried by
    // ADR-0074, amended at D28.11). `transit` is Turborepo's documented node
    // for that: no workspace defines the script, so nothing runs and nothing
    // waits, but each package's `transit` hashes its files and its
    // dependencies' `transit`. `^test:unit` would do the same by running the
    // packages' suites first, serialising the fast loop for no reason.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test:unit": {
      "dependsOn": ["transit"]
    },
    "size": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/size.mjs"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": [],
      "env": [
        "SEED_SUPER_ADMIN_*",
        "E2E_BASE_URL",
        "E2E_API_URL",
        "E2E_MAILPIT_URL",
        "E2E_CUSTOMER_*",
        "CI"
      ]
    },
    "test:int": {
      "cache": false,
      "dependsOn": [],
      "env": [
        "APP_ID",
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_OWNER",
        "DB_*",
        "REDIS_URL",
        "ERROR_REPORTING_DSN",
        "METRICS_TOKEN"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint", "//#test:scripts", "//#docs:check", "i18n:check"]
    },
    "//#test:scripts": {},
    "//#docs:check": {},
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist-types/**"]
    },
    "i18n:check": {
      "dependsOn": []
    },
    "i18n:extract": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    },
    "db:seed": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    },
    "db:sessions:prune": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    },
    "db:setup": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    },
    "db:reset": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_OWNER",
        "DB_*",
        "ARGON2_*",
        "SEED_SUPER_ADMIN_*"
      ]
    }
  }
}
