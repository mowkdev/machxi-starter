{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": [
        "build/**",
        ".vercel/**",
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": [],
      "env": ["DATABASE_URL", "DATABASE_URL_TEST"]
    },
    "test:unit": {
      "dependsOn": []
    },
    "test:int": {
      "cache": false,
      "dependsOn": [],
      "env": ["DATABASE_URL", "DATABASE_URL_TEST"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    },
    "db:sessions:prune": {
      "cache": false,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    },
    "db:setup": {
      "cache": false,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    },
    "db:reset": {
      "cache": false,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "ARGON2_*", "SEED_SUPER_ADMIN_*"]
    }
  }
}
