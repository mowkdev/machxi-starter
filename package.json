{
  "name": "machxi-starter",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,md,json,css}\"",
    "lint": "turbo run lint",
    "check": "turbo run lint check-types test:unit i18n:check",
    "test": "turbo run test --concurrency=1",
    "test:unit": "turbo run test:unit",
    "size": "turbo run size --filter=admin --filter=customer",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:int": "turbo run test:int --concurrency=1",
    "test:watch": "turbo run test:watch",
    "test:postman": "node --no-deprecation scripts/postman.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "rules:digest": "node scripts/rules-digest.mjs",
    "docs:check": "node scripts/docs-hygiene.mjs",
    "check-types": "turbo run check-types",
    "i18n:check": "turbo run i18n:check",
    "i18n:extract": "turbo run i18n:extract",
    "docker:up": "docker compose --env-file .env -f docker/local/compose.yaml up -d --wait",
    "docker:down": "docker compose --env-file .env -f docker/local/compose.yaml down",
    "docker:reset": "docker compose --env-file .env -f docker/local/compose.yaml down -v && pnpm docker:up",
    "docker:logs": "docker compose --env-file .env -f docker/local/compose.yaml logs -f",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:sessions:prune": "turbo run db:sessions:prune",
    "db:setup": "turbo run db:setup",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.13",
    "newman": "^6.2.2",
    "prettier": "^3.9.7",
    "turbo": "^2.10.13"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0"
  }
}
