import type { {{pascalCase name}}Resource } from "@repo/contracts";

import { useDelete{{pascalCase name}} } from "@/entities/{{kebabCase name}}";
import type { BulkTarget } from "@/shared/api/bulk-outcome";
import { useT } from "@/shared/i18n";
import { ConfirmDialog } from "@/shared/ui";

import { useBulkDelete{{pascalCase plural}} } from "./use-bulk-delete-{{kebabCase plural}}";

/**
 * The {{name}} actions with no form to host them (ADR-0040).
 *
 * Both keep ADR-0034's error toast, because a confirm has no field for a
 * refusal to land on — and **none of them is pre-guessed in the client**. What
 * may and may not be deleted is the service's, it depends on state this app
 * does not hold, and a client that guessed would eventually guess wrong in the
 * permissive direction. So the menu offers the action, the API refuses it, and
 * the operator reads the sentence ADR-0034's map wrote for that code.
 */

export const Delete{{pascalCase name}}Dialog = ({
  {{camelCase name}},
  onClose,
}: {
  readonly {{camelCase name}}: {{pascalCase name}}Resource;
  readonly onClose: () => void;
}) => {
  const { t } = useT("{{camelCase plural}}");
  const delete{{pascalCase name}} = useDelete{{pascalCase name}}();

  return (
    <ConfirmDialog
      open
      onOpenChange={(next) => {
        if (!next) onClose();
      }}
      title={t("delete.title", { name: {{camelCase name}}.name })}
      /*
       * Say what actually happens to the row. "Cannot be undone" is true of a
       * hard delete and a lie about a soft one, and the two resources next to
       * each other in this app already differ — so this sentence is the
       * resource's, not the dialog's.
       */
      description={t("delete.description")}
      confirmLabel={t("delete.confirm")}
      destructive
      isPending={delete{{pascalCase name}}.isPending}
      onConfirm={() => {
        delete{{pascalCase name}}.mutate({{camelCase name}}.id, { onSuccess: onClose });
      }}
    />
  );
};

/**
 * The bulk confirm (ADR-0038): one dialog, one fan-out, one summary.
 *
 * Nothing is pre-guessed about which of the selection will be refused: the
 * operator is warned that some may be, and the summary says which were.
 */
export const BulkDelete{{pascalCase plural}}Dialog = ({
  ids,
  rows,
  onSettled,
  onClose,
}: {
  readonly ids: readonly string[];
  readonly rows: readonly {{pascalCase name}}Resource[];
  readonly onSettled: () => void;
  readonly onClose: () => void;
}) => {
  const { t } = useT("{{camelCase plural}}");
  const bulkDelete = useBulkDelete{{pascalCase plural}}();

  /*
   * The label is resolved from the page in hand and falls back to the id.
   * Selection survives paging (ADR-0038), so a selected row may not be among
   * `rows` at all — the fallback is the honest floor, and fetching the missing
   * rows would be a request made only so a toast could read better.
   */
  const targets: readonly BulkTarget[] = ids.map((id) => ({
    id,
    label: rows.find((row) => row.id === id)?.name ?? id,
  }));

  return (
    <ConfirmDialog
      open
      onOpenChange={(next) => {
        if (!next) onClose();
      }}
      title={t("bulkDelete.title", { count: ids.length })}
      description={t("bulkDelete.description")}
      confirmLabel={t("bulkDelete.confirm")}
      destructive
      isPending={bulkDelete.isPending}
      onConfirm={() => {
        bulkDelete.mutate(targets, {
          /*
           * `onSuccess`, not `onSettled`: the fan-out's promise resolves
           * whenever `allSettled` does, refusals included, so this runs exactly
           * once for the whole batch — and the refused rows stay on screen with
           * the toast naming why they remain.
           */
          onSuccess: () => {
            onSettled();
            onClose();
          },
        });
      }}
    />
  );
};
