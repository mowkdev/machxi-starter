import { listQuerySearchSchema } from "@repo/contracts";
import {
  Outlet,
  createFileRoute,
  stripSearchParams,
  useMatchRoute,
} from "@tanstack/react-router";

import { {{camelCase name}}ResourceConfig } from "@/entities/{{kebabCase name}}";
import { {{pascalCase plural}}Page } from "@/pages/{{kebabCase plural}}";
import { listSearchDefaults } from "@/shared/grid/list-state";
import { editSurfaceOf } from "@/shared/resource/config";

/**
 * `/{{kebabCase plural}}` — wiring, plus the list state (ADR-0034 §List state
 * lives in the URL).
 *
 * **`listQuerySearchSchema` and not `list{{pascalCase plural}}Query`**, and the
 * difference is load-bearing. The per-endpoint builder parses the *wire* form
 * and outputs the *parsed* one — `sort: string` in, `sort: SortSpec[]` out —
 * and TanStack Router round-trips its validated output back into the URL on
 * every navigation. So the endpoint schema would be handed its own output on
 * the first pager click and reject it, and a `.catch` would turn that into a
 * silent reset to page one.
 *
 * The endpoint's allow-lists are still enforced — by the API when the request
 * gets there, and by the config test before that. This schema guarantees the
 * URL is readable back as the object that wrote it; it deliberately does not
 * restate the allow-list.
 *
 * Defaults are stripped from every built link: the URL carries only deviations,
 * so `/{{kebabCase plural}}` *is* page one at the default size. The middleware
 * is fed the schema's own `parse({})` output, so the two cannot disagree about
 * what "default" means.
 *
 * **This route renders the grid *and* an `<Outlet />`** (ADR-0040):
 * `/{{kebabCase plural}}/new` and `/{{kebabCase plural}}/$id` render a record
 * surface into it. `validateSearch` stays here rather than moving down, so the
 * list state is validated once and is visible to the index and the children
 * alike — and the grid below reads *this route's* search, which while a record
 * is open is the record URL's and has no list params. That is why the page
 * reads the carried snapshot rather than `useSearch` alone (ADR-0044).
 */
export const Route = createFileRoute("/_dashboard/{{kebabCase plural}}")({
  component: {{pascalCase plural}}Route,
  staticData: {
    title: "{{camelCase plural}}:title",
    // The page-header band's second line (ADR-0054 §5), declared beside the
    // title so the two cannot drift.
    description: "{{camelCase plural}}:description",
    // A grid page is a height budget, not a document (ADR-0037) — and that is
    // also what selects the full-bleed page container the band layout needs.
    fullHeight: true,
  },
  validateSearch: listQuerySearchSchema,
  search: {
    middlewares: [stripSearchParams(listSearchDefaults)],
  },
});

function {{pascalCase plural}}Route() {
  /*
   * Route topology follows the surface, in one place (ADR-0040).
   *
   * A dialog or a drawer overlays a grid that stays on screen, so the grid
   * renders regardless. A `page` surface replaces it, so the grid unmounts
   * while a record child matches — one conditional, and the child component
   * knows nothing about it.
   *
   * `useMatchRoute` rather than counting child matches: the index route is a
   * child too, so a count would say "a record is open" while looking at the
   * bare list. Asking about the two record paths by name is also typed — a
   * renamed route is a compile error here rather than a grid that stopped
   * disappearing.
   */
  const matchRoute = useMatchRoute();
  /*
   * Two things this call has to say explicitly:
   *
   * - **`includeSearch: false`.** `matchRoute` compares search params as well
   *   as the path by default, so asking about `/new` while the URL carries list
   *   params answers *no* — and the grid would stay mounted under a `page`
   *   surface that had already replaced it.
   * - **`||`, not `??`.** A miss is `false`, not `undefined`, so `??` would
   *   return the first miss and never ask about the second path.
   */
  const onRecord = Boolean(
    matchRoute({ to: "/{{kebabCase plural}}/new", includeSearch: false }) ||
      matchRoute({
        to: "/{{kebabCase plural}}/${{camelCase name}}Id",
        includeSearch: false,
      }),
  );
  const replacesTheGrid = editSurfaceOf({{camelCase name}}ResourceConfig) === "page";

  return (
    <>
      {replacesTheGrid && onRecord ? null : <{{pascalCase plural}}Page />}
      <Outlet />
    </>
  );
}
