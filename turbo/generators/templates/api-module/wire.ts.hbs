{{#if organizationScoped}}
import type { RunInTransaction } from "../../core/db/index.js";
{{else}}
import type { DbExecutor } from "@repo/db";
{{/if}}

import { create{{pascalCase plural}}Controller } from "./{{kebabCase plural}}.controller.js";
import { create{{pascalCase plural}}Repository } from "./{{kebabCase plural}}.repository.js";
import { create{{pascalCase plural}}Service } from "./{{kebabCase plural}}.service.js";

/** What the composition root hands this module (ADR-0073 §10). */
export interface Wire{{pascalCase plural}}Deps {
{{#unless organizationScoped}}
  readonly db: DbExecutor;
{{/unless}}
{{#if organizationScoped}}
  /**
   * The root's transaction helper (ADR-0078 §3 and §4 as amended at `D29.4`):
   * a tenant-owned repository borrows it so a read outside a caller's
   * transaction opens one in the request's scope — and never the bare pool,
   * which is why the module is handed no client.
   */
  readonly transaction: RunInTransaction;
{{/if}}
}

/**
 * This module's wiring (ADR-0073 §10).
 *
 * One `wire<Module>` per module, so the composition root stays construction
 * order: `core/container.ts` calls this once and reads the three maps it
 * returns. Everything this module needs from outside — another module's
 * service, the audit writer, the mail port, a transaction runner — arrives as
 * a field of {@link Wire{{pascalCase plural}}Deps} and never as an import of
 * the root's own file.
 *
 * It is composition, not a layer, and the ESLint rule on `wire*` files keeps
 * it that way: no Express here, and no schema tables (ADR-0009).
 */
export const wire{{pascalCase plural}} = ({ {{#if organizationScoped}}transaction{{else}}db{{/if}} }: Wire{{pascalCase plural}}Deps) => {
  const repository = create{{pascalCase plural}}Repository({{#if organizationScoped}}transaction{{else}}db{{/if}});
  const {{camelCase plural}} = create{{pascalCase plural}}Service({ repository });

  return {
    repositories: { {{camelCase plural}}: repository } as const,
    services: { {{camelCase plural}} } as const,
    controllers: {
      {{camelCase plural}}: create{{pascalCase plural}}Controller({{camelCase plural}}),
    } as const,
  } as const;
};
