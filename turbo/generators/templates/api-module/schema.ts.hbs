import { index, pgTable, text{{#if organizationScoped}}, uuid{{/if}} } from "drizzle-orm/pg-core";

import { primaryId, timestamps } from "./_shared.js";

/**
 * `{{snakeCase plural}}` (ADR-0006).
 *
 * One file per aggregate; `relations()` sits beside the tables it joins, so
 * this file grows a `relations(...)` export the day this table is read together
 * with another one.
 */
export const {{camelCase plural}} = pgTable(
  "{{snakeCase plural}}",
  {
    id: primaryId(),
{{#if organizationScoped}}
    /**
     * The owning organization (ADR-0067 §1).
     *
     * `not null` and never nullable: a nullable tenant column grows a null
     * branch in every query, and the null branch is where the leaks live.
     *
     * **The foreign key lands with `organizations` itself**, which ADR-0067
     * builds at D15 — add `.references(() => organizations.id)` in the same
     * migration that creates that table.
     */
    organizationId: uuid().notNull(),
{{/if}}
    name: text().notNull(),
    /** `null` is "none given", which is a different fact from `''`. */
    description: text(),
    ...timestamps(),
  },
  (table) => [
{{#if organizationScoped}}
    /*
     * Led by the tenant column (ADR-0067 §1): every query on this table filters
     * by `organization_id` first, so it is the leading column of the index that
     * serves the list rather than an afterthought appended to it — and there is
     * one per order the endpoint offers, because a tenant-led index on
     * `created_at` does nothing for `ORDER BY updated_at` inside the same
     * organization.
     *
     * **These do not replace the bare pairs below, and that is a tension worth
     * knowing about.** `indexCoverage` in `@repo/db/testing` attributes an index
     * to its *leading* column only (ADR-0060 §3 asked for a set comparison, not
     * a planner), so under a tenant-led index alone every `sortable` column
     * reads as uncovered and the generated `list-indexes.test.ts` reddens. Both
     * sets are therefore declared: the tenant-led ones are what a tenant query
     * actually reads, the bare ones are what the rule can see. Which of the two
     * gives way is ADR-0067's to decide when D15 builds it; a generator must not
     * settle it by dropping whichever set is inconvenient.
     */
    index("{{snakeCase plural}}_organization_id_created_at_idx").on(
      table.organizationId,
      table.createdAt,
      table.id,
    ),
    index("{{snakeCase plural}}_organization_id_updated_at_idx").on(
      table.organizationId,
      table.updatedAt,
      table.id,
    ),
    index("{{snakeCase plural}}_organization_id_name_idx").on(
      table.organizationId,
      table.name,
      table.id,
    ),
{{/if}}
    /*
     * One btree index per sortable column, composite with `id` (ADR-0060 §3):
     * `applyListQuery` appends `asc(id)` to every `ORDER BY`, so `(column, id)`
     * is the pagination key rather than a prefix of it, and a filter on the
     * leading column is served by the same index.
     */
    index("{{snakeCase plural}}_created_at_idx").on(table.createdAt, table.id),
    index("{{snakeCase plural}}_updated_at_idx").on(table.updatedAt, table.id),
    index("{{snakeCase plural}}_name_idx").on(table.name, table.id),
    /*
     * What `q` searches (ADR-0060 §3). `ilike '%term%'` reads no btree index,
     * so each searched column gets a `pg_trgm` GIN one — the extension arrives
     * by migration and is already in the tree.
     */
    index("{{snakeCase plural}}_name_trgm_idx").using(
      "gin",
      table.name.op("gin_trgm_ops"),
    ),
  ],
);
