import { index, pgTable, text{{#if organizationScoped}}, uuid{{/if}} } from "drizzle-orm/pg-core";

import { primaryId, timestamps } from "./_shared.js";
{{#if organizationScoped}}
import { organizations } from "./organizations.js";
{{/if}}

/**
 * `{{snakeCase plural}}` (ADR-0006).
 *
 * One file per aggregate; `relations()` sits beside the tables it joins, so
 * this file grows a `relations(...)` export the day this table is read together
 * with another one.
 */
export const {{camelCase plural}} = pgTable(
  "{{snakeCase plural}}",
  {
    id: primaryId(),
{{#if organizationScoped}}
    /**
     * The owning organization (ADR-0067 §1).
     *
     * `not null` and never nullable: a nullable tenant column grows a null
     * branch in every query, and the null branch is where the leaks live.
     *
     * `cascade`, as every tenant-owned table does: deleting an organization for
     * real takes what it owned with it. The application soft-deletes instead
     * (ADR-0067 §3), so this fires only where a hard delete is deliberate.
     */
    organizationId: uuid()
      .notNull()
      .references(() => organizations.id, { onDelete: "cascade" }),
{{/if}}
    name: text().notNull(),
    /** `null` is "none given", which is a different fact from `''`. */
    description: text(),
    ...timestamps(),
  },
  (table) => [
{{#if organizationScoped}}
    /*
     * Led by the tenant column, one per order the endpoint offers, and **no
     * bare `(column, id)` pairs beside them** (ADR-0067 §1).
     *
     * Every query on this table filters by `organization_id` first, so the
     * tenant column is the leading column of the index that serves the list
     * rather than an afterthought appended to it — and there is one composite
     * per order, because a tenant-led index on `created_at` does nothing for
     * `ORDER BY updated_at` inside the same organization.
     *
     * The bare pairs `organizations` itself declares are absent here on
     * purpose. ADR-0063 §3 recorded the tension: `indexCoverage` in
     * `@repo/db/testing` attributed an index to its *leading* column, so under
     * tenant-led indexes alone every `sortable` column read as uncovered and
     * both sets had to be declared. ADR-0067 §1 settled it the other way —
     * a query on a tenant table never orders unscoped, so a bare index would
     * never be read — and taught the checker the scope through `scopedBy`,
     * which the generated `list-indexes.test.ts` passes.
     */
    index("{{snakeCase plural}}_organization_id_created_at_idx").on(
      table.organizationId,
      table.createdAt,
      table.id,
    ),
    index("{{snakeCase plural}}_organization_id_updated_at_idx").on(
      table.organizationId,
      table.updatedAt,
      table.id,
    ),
    index("{{snakeCase plural}}_organization_id_name_idx").on(
      table.organizationId,
      table.name,
      table.id,
    ),
{{else}}
    /*
     * One btree index per sortable column, composite with `id` (ADR-0060 §3):
     * `applyListQuery` appends `asc(id)` to every `ORDER BY`, so `(column, id)`
     * is the pagination key rather than a prefix of it, and a filter on the
     * leading column is served by the same index.
     */
    index("{{snakeCase plural}}_created_at_idx").on(table.createdAt, table.id),
    index("{{snakeCase plural}}_updated_at_idx").on(table.updatedAt, table.id),
    index("{{snakeCase plural}}_name_idx").on(table.name, table.id),
{{/if}}
    /*
     * What `q` searches (ADR-0060 §3). `ilike '%term%'` reads no btree index,
     * so each searched column gets a `pg_trgm` GIN one — the extension arrives
     * by migration and is already in the tree. A GIN index is never composite,
     * so it is the same declaration scoped or not.
     */
    index("{{snakeCase plural}}_name_trgm_idx").using(
      "gin",
      table.name.op("gin_trgm_ops"),
    ),
  ],
);
